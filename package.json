{
    "name": "project-fusion",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "setup": "node scripts/setup.js",
        "test": "jest --coverage",
        "test:unit": "jest tests/unit --coverage",
        "test:integration": "jest tests/integration",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "docker:up": "docker-compose up -d",
        "prepare": "husky"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "*.js",
            "adapters/*.js",
            "!node_modules/**",
            "!tests/**",
            "!coverage/**"
        ]
    },
    "dependencies": {
        "@stellar/stellar-sdk": "^13.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "joi": "^17.13.3",
        "pg": "^8.13.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "prom-client": "^15.1.3",
        "stripe": "^17.5.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "axios": "^1.13.4",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-node": "^11.1.0",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2"
    }
}
