{
    "name": "project-fusion",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "setup": "node scripts/setup.js",
        "test": "jest --coverage",
        "test:unit": "jest tests/unit --coverage",
        "test:integration": "jest tests/integration --forceExit",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:up": "docker-compose up -d",
        "knip": "knip",
        "prepare": "node -e \"if (process.env.CI) process.exit(0); const { execSync } = require('child_process'); execSync('husky', { stdio: 'inherit' });\""
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "*.js",
            "adapters/*.js",
            "!node_modules/**",
            "!tests/**",
            "!coverage/**"
        ]
    },
    "dependencies": {
        "@levischuck/tiny-cbor": "0.2.11",
        "@opentelemetry/context-async-hooks": "1.30.1",
        "@opentelemetry/core": "1.30.1",
        "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
        "@opentelemetry/resources": "1.30.1",
        "@opentelemetry/sdk-trace-base": "1.30.1",
        "@simplewebauthn/server": "^14.0.3",
        "@stellar/stellar-sdk": "^13.1.0",
        "cors": "^2.8.5",
        "csv-parse": "^6.2.1",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "ioredis": "^5.10.1",
        "joi": "^17.13.3",
        "kafkajs": "^2.2.4",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "ollama": "^0.6.3",
        "pdf2json": "^4.0.2",
        "pg": "^8.13.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "prom-client": "^15.1.3",
        "stripe": "^17.5.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@types/jest": "^29.5.14",
        "axios": "^1.13.4",
        "eslint": "^9.14.0",
        "globals": "^15.11.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "knip": "6.44.1",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2"
    }
}
